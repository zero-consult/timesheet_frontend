  "container": <div>
    <header
      class="px-8 py-6 border-b border-border flex items-center justify-between"
    >
      <div>
        <h1
          class="text-xl font-semibold text-foreground tracking-tight"
          style="font-family: "Instrument Sans", sans-serif;"
        >
          menu.timesheets
        </h1>
        <p
          class="text-sm text-muted-foreground mt-0.5"
        >
          20 Jul – 26 Jul 2026
        </p>
      </div>
      <div
        class="flex items-center gap-3"
      >
        <div
          class="flex items-center gap-1 bg-secondary rounded-md p-1"
        >
          <button
            class="px-2.5 py-1 rounded text-sm text-muted-foreground hover:text-foreground hover:bg-card transition-colors"
          >
            ‹
          </button>
          <button
            class="px-3 py-1 rounded text-xs font-medium text-muted-foreground hover:text-foreground hover:bg-card transition-colors"
            style="font-family: "DM Mono", monospace;"
          >
            timesheetlist.today
          </button>
          <button
            class="px-2.5 py-1 rounded text-sm text-muted-foreground hover:text-foreground hover:bg-card transition-colors"
          >
            ›
          </button>
        </div>
        <a
          class="flex items-center gap-2 px-4 py-2.5 rounded-md bg-primary text-primary-foreground text-sm font-medium hover:bg-primary/90 transition-colors"
          data-discover="true"
          href="/timesheets/add"
        >
          <svg
            aria-hidden="true"
            class="lucide lucide-plus w-4 h-4"
            fill="none"
            height="24"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            width="24"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M5 12h14"
            />
            <path
              d="M12 5v14"
            />
          </svg>
           
          timesheetlist.register
        </a>
      </div>
    </header>
    <div
