          </p>
        </div>
        <div
          class="flex items-center gap-3"
        >
          <div
            class="flex items-center gap-1 bg-secondary rounded-md p-1"
          >
            <button
              class="px-2.5 py-1 rounded text-sm text-muted-foreground hover:text-foreground hover:bg-card transition-colors"
            >
              ‹
            </button>
            <button
              class="px-3 py-1 rounded text-xs font-medium text-muted-foreground hover:text-foreground hover:bg-card transition-colors"
              style="font-family: "DM Mono", monospace;"
            >
              timesheetlist.today
            </button>
            <button
              class="px-2.5 py-1 rounded text-sm text-muted-foreground hover:text-foreground hover:bg-card transition-colors"
            >
              ›
            </button>
          </div>
          <a
            class="flex items-center gap-2 px-4 py-2.5 rounded-md bg-primary text-primary-foreground text-sm font-medium hover:bg-primary/90 transition-colors"
            data-discover="true"
            href="/timesheets/add"
